#!/bin/bash
# ET Toolbox Credentials Configuration File
# 
# This file contains environment variables for authenticating with various data sources.
# Replace the placeholder values with your actual credentials before building the container.
# Keep this file secure and do not commit it to version control.

# =============================================================================
# GITLAB CREDENTIALS (Used during container build only)
# =============================================================================
# These credentials are used to clone private repositories from Reclamation GitLab
# during the Docker container build process.
#
# How to obtain:
# 1. Go to the Reclamation GitLab server
# 2. Navigate to your project settings > Access Tokens
# 3. Create a new project access token with 'read_repository' permissions
# 4. Token expires annually - refresh by January 1st each year
#
export GIT_USERNAME="YOUR_GITLAB_USERNAME"
export GIT_TOKEN="YOUR_GITLAB_PROJECT_ACCESS_TOKEN"

# =============================================================================
# USGS EROS CREDENTIALS (Earth Resources Observation and Science)
# =============================================================================
# Used for accessing USGS satellite data and Landsat imagery
#
# How to obtain:
# 1. Create account at: https://ers.cr.usgs.gov/register
# 2. Username and password are your login credentials (static, don't change)
# 3. For M2M API access:
#    - Request access at: https://m2m.cr.usgs.gov/
#    - Once approved, generate an Application token
#    - This token periodically expires and needs refresh
#
export EROS_USERNAME="YOUR_EROS_LOGIN_USERNAME"
export EROS_PASSWORD="YOUR_EROS_LOGIN_PASSWORD"
export EROS_TOKEN="YOUR_EROS_M2M_API_TOKEN"

# =============================================================================
# NASA EARTHDATA CREDENTIALS
# =============================================================================
# Used for accessing NASA Earth science data including MODIS, VIIRS, and other datasets
#
# How to obtain:
# 1. Register at: https://urs.earthdata.nasa.gov/
# 2. Create a username/password combination
# 3. The system automatically handles token management using these credentials
#
export EARTHDATA_USERNAME="YOUR_EARTHDATA_USERNAME"
export EARTHDATA_PASSWORD="YOUR_EARTHDATA_PASSWORD"

# =============================================================================
# SPACETRACK CREDENTIALS
# =============================================================================
# Used for accessing satellite orbital data and Two-Line Element (TLE) sets
# Required for VIIRS satellite orbit calculations
#
# How to obtain:
# 1. Register at: https://www.space-track.org/auth/login
# 2. Create account and verify email
# 3. Use your login username and password
#
export SPACETRACK_USERNAME="YOUR_SPACETRACK_USERNAME"
export SPACETRACK_PASSWORD="YOUR_SPACETRACK_PASSWORD"

# =============================================================================
# NOTES:
# =============================================================================
# - This file is sourced as a shell script, so use proper bash syntax
# - Do not include spaces around the '=' in export statements
# - Keep credentials secure and rotate them periodically
# - Some tokens (EROS_BEARER, EARTHDATA_TOKEN) are auto-generated by the system
# - To update credentials in a running container:
#   1. Either rebuild the container, OR
#   2. Update both this file and the copy in the production system at /root/.credentials
